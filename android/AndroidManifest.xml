<?xml version="1.0" encoding="utf-8"?>
<!--
  package 必须手写：AGP 会从 build.gradle 的 applicationId 注入，
  本项目不走 Gradle，aapt2 需要它来定位 R 类的包名。

  包名沿用旧版 ds.app：Android 靠「包名相同 + 签名证书相同」判定为同一次升级，
  改名等于换一个应用，已装的旧版本无法被覆盖升级（只能先卸载，本地 IndexedDB 全丢）。
  签名私钥因此也必须沿用 android\debug.keystore（见 tools\build-apk.ps1）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ds.app">

    <!--
      只需要 INTERNET。导出走 Storage Access Framework（系统文件选择器），
      用户自己选位置；导入走 ACTION_GET_CONTENT 让用户挑文件。
      两条路都不需要任何存储权限，因此 API 28 及以下也不会遇到
      "权限已授予但仍 Permission denied" 的系统差异。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      局域网直连要用 WifiManager.createMulticastLock()：Android 的 Wi-Fi 驱动默认过滤
      发往广播/组播的包，不加这把锁就永远收不到对端广播（但能发出去 —— 症状是「别人看得见我、
      我看不见别人」）。这是 normal 级权限，安装即授予，用户看不到权限提示。
      INTERNET 已经覆盖普通 socket；这里只补组播锁这一项，别的都不要。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      扫码配对要用 Camera2 预览。CAMERA 是 dangerous 权限，targetSdk 34 下必须运行时申请
      （ScanActivity.ensurePermissionThenOpen → requestPermissions，不用 AndroidX）。

      这是本项目**唯一**一条会弹系统对话框的权限。拒绝也不影响其余功能：
      扫码界面会降到「从图片选择」，设置页里还能直接粘贴配对串。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      required="false"：不把「有摄像头」当成安装前提。没有相机的设备（部分平板、模拟器）
      照样能装，只是扫码界面直接给「从图片选择」—— 这条声明就是那句保证的出处，
      tools/verify-apk.ps1 里有断言钉着它。
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!--
      targetSdk 停在 34 是刻意的：升到 35 后 Android 15 会强制 edge-to-edge，
      状态栏 / 导航栏变成覆盖在内容上，得再补一套 inset 处理。

      networkSecurityConfig 取代 usesCleartextTraffic：局域网多端同步要连
      http://192.168.x.x:7788（见 res\xml\network_security_config.xml 里的理由）。
      API 24+ 上这个属性优先于 usesCleartextTraffic，所以后者删掉，
      免得两处设置互相打架、读代码时又被误导。
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">

        <activity
            android:name="ds.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          扫码界面：独立 Activity（不是盖在 WebView 上的一层预览），结果只走
          setResult → MainActivity.onActivityResult → evaluateJavascript 回页面。

          exported="false"：只有本应用能拉起它。
          configChanges 与 MainActivity 同一套：旋转/改字号时不重建，正在跑的预览不会断
          （重建会让「相机已经交给旧实例」变成 Camera in use）。
          parentActivityName 不写：本应用不用 ActionBar/向上导航。
        -->
        <activity
            android:name="ds.app.ScanActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/ScanTheme" />
    </application>
</manifest>
