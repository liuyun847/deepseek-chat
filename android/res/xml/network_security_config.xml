<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置。

  同步链路已切到 HTTPS
  ====================
  多端同步走 https://<主机>:7788，自签证书由配对时记录的 SHA-256 指纹固定
  （MainActivity.onReceivedSslError 校验）。全应用只有 WebView 这一条 HTTP 栈，
  没有绕开它的原生传输层，因此这里不需要放开明文。

  https 完全不受影响：DeepSeek API 走的仍是 https + 系统信任链，系统 CA 一份没动。
  tools\verify-apk.ps1 有对应校验，防止这份配置被改回 true 而没人发现。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
