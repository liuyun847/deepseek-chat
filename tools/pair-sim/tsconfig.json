{
  // 配对串工具（tools/pair-qr-sim.mjs）的编译配置：只编「纯逻辑」那几层，不碰 React 组件。
  // 产物在 build/ 下（已 gitignore），由 pair-qr-sim.mjs 直接 import（Node 24 的 ESM）。
  // 全仓唯一的子集编译配置：根 tsconfig.json 管全量，这里只收窄 include 到工具用得到的那几层。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build",
    "rootDir": "../..",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "../../src/env.d.ts",
    "../../src/services/sync/pairing.ts",
    "../../src/services/sync/api.ts",
    "../../src/services/sync/tls.ts",
    "../../src/services/localService.ts"
  ]
}
