{
  // 单机双端模拟用的编译配置：只把「纯逻辑」那几层编出 JS，不碰 React / IndexedDB。
  // 产物在 build/ 下，由 peer.mjs / run.mjs 直接 import（Node 24 的 ESM）。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build",
    "rootDir": "../..",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "../../src/env.d.ts",
    "../../src/services/sync/protocol.ts",
    "../../src/services/sync/merge.ts",
    "../../src/services/sync/lan/protocol.ts",
    "../../src/services/sync/lan/crypto.ts",
    "../../src/services/sync/lan/transfer.ts",
    "../../src/utils/id.ts"
  ]
}
