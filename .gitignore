node_modules/
dist/
build/
.pnpm-store/
.cache/
*.log
.DS_Store
.env
.env.*
!.env.example
# 本机密钥：构建期注入产物的 API key（rspack.config.ts 读它，tools\build-apk.ps1 核对它）
.secrets/
tmp/
# 多端同步服务的本地数据文件（sync-server/server.mjs --data 的默认位置）
sync-server/data/
# 自签 TLS 证书与私钥（sync-server/gen-cert.mjs 生成）
sync-server/tls/
# APK 产物（tools/build-apk.ps1 输出，中间产物落在 build/）
dist-apk/
# 签名私钥：绝不可提交。丢了它就无法覆盖升级已安装的应用
android/debug.keystore
# 手机直连对端（lan-peer）的运行期产物：日志、状态文件、本机设备 id
lan-peer/logs/
