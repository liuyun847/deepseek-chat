{
  // 电脑端直连对端的编译配置：只把「纯逻辑」那几层编出 JS，不碰 React / IndexedDB。
  // 产物在 build/ 下，由 peer.mjs 等直接 import（Node 24 的 ESM）。
  // 为什么不在运行时直接跑 .ts：源码里写的是 NodeNext 要求的 './protocol.js'，
  // Node 的 TypeScript 支持不会把 .js 说明符映射到 .ts（实测 ERR_MODULE_NOT_FOUND），
  // 所以沿用 tools/lan-sim 的做法：编译一次，跑产物。
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build",
    "rootDir": "..",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "../src/env.d.ts",
    "../src/services/sync/protocol.ts",
    "../src/services/sync/merge.ts",
    "../src/services/sync/lan/protocol.ts",
    "../src/services/sync/lan/crypto.ts",
    "../src/services/sync/lan/transfer.ts",
    "../src/utils/id.ts"
  ]
}
